# COLORLINK: despliegue público en un único servicio Render.
# El backend FastAPI escucha SOLO en localhost dentro del contenedor.
# Streamlit es el único proceso expuesto mediante el puerto asignado por Render.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    API_BASE_URL=http://127.0.0.1:8000

WORKDIR /code

COPY backend/requirements.txt /tmp/backend-requirements.txt
COPY frontend/requirements.txt /tmp/frontend-requirements.txt
RUN pip install --no-cache-dir \
    -r /tmp/backend-requirements.txt \
    -r /tmp/frontend-requirements.txt

COPY backend/ /code/backend/
COPY frontend/ /code/frontend/
COPY deploy/ /code/deploy/

EXPOSE 10000

CMD ["python", "-m", "deploy.serve"]
